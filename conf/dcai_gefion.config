params {

    config_profile_contact     = 'Samuel Ruiz-Pérez <samper@cancer.dk> (@samuelruizperez)'
    config_profile_description = 'DCAI GEFION configuration. Written by Samuel Ruiz-Pérez <samper@cancer.dk>. For support and questions about GEFION contact <support@dcai.dk>.'
    config_profile_url         = 'https://github.com/grothlab/configs/blob/master/conf/dcai_gefion.config'

}

cleanup = false

apptainer {
    enabled    = true
    autoMounts = true
    // PREPEND_PATH extends the image's own PATH; setting PATH directly would replace it, which
    // breaks images that install elsewhere (e.g. Wave/pixi images use /opt/wave/.pixi/envs/default/bin).
    runOptions = '--env PREPEND_PATH=/opt/conda/bin:/opt/conda/condabin'
}

process {
    beforeScript = 'module load Apptainer/1.3.6;'
    resourceLimits = [
        memory: 2000.GB,
        cpus: 224,
        time: 168.h,
    ]
    executor = 'slurm'
    queue  = 'defq'
    clusterOptions   = { [
        "--account=${env('SBATCH_ACCOUNT')}",
        env('SBATCH_RESERVATION') ? "--reservation=${env('SBATCH_RESERVATION')}" : '',
        task.accelerator ? "--gpus=${task.accelerator.request}" : ''
    ].join(' ').trim() }
    containerOptions = {
        task.accelerator && workflow.containerEngine == 'docker' ? '--gpus all'
            : task.accelerator && workflow.containerEngine in ['singularity', 'apptainer'] ? '--nv'
            : null
    }
}

executor {
    queueSize       = 64
    submitRateLimit = '48/1min'
}
