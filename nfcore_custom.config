/*
========================================================================================
    grothlab custom institutional profiles Nextflow config file
========================================================================================
    A collection of institutional profiles for grothlab nf-core-template pipelines. Each
    profile below dynamically includes the matching conf/<profile_name>.config file from
    this repository - nothing is loaded until a pipeline actually selects that profile.

    To use a profile: -profile <profile_name>[,<sub_profile>][,<container_engine>]
    e.g.              -profile ku_cpromegate,cpr_ag,singularity

    To make a pipeline able to load these profiles in the first place, add this to its
    nextflow.config - a separate params.custom_grothlab_config_base/_version from
    nf-core-template's own params.custom_config_base/nf-core/configs mechanism, so both
    can be loaded independently:

        params {
            custom_grothlab_config_version = 'main'
            custom_grothlab_config_base    = "https://raw.githubusercontent.com/grothlab/configs/${params.custom_grothlab_config_version}"
        }

        includeConfig params.custom_grothlab_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_grothlab_config_base.startsWith('http')) ? "${params.custom_grothlab_config_base}/nfcore_custom.config" : "/dev/null"

    See README.md for the full profile list and per-profile docs.
========================================================================================
*/

profiles {
    dcai_gefion         { includeConfig "${params.custom_grothlab_config_base}/conf/dcai_gefion.config"         }
    ku_cpromegate       { includeConfig "${params.custom_grothlab_config_base}/conf/ku_cpromegate.config"       }
    ku_sund_danhead_mod { includeConfig "${params.custom_grothlab_config_base}/conf/ku_sund_danhead_mod.config" }
}
