/*
========================================================================================
    grothlab custom institutional profiles Nextflow config file
========================================================================================
    A collection of institutional profiles for grothlab Nextflow pipelines.

    To use a profile with any grothlab or nf-core pipeline, override its existing
    params.custom_config_base (normally pointed at nf-core/configs) to point here
    instead, then select a profile with -profile.
    
    From the CLI:

        nextflow run <pipeline> \
            --custom_config_base https://raw.githubusercontent.com/grothlab/configs/master \
            -profile <profile_name>,<...>


    Or via a `-params-file` (e.g., `params.yml`):

        custom_config_base: "https://raw.githubusercontent.com/grothlab/configs/master"

        nextflow run <pipeline> \
            -params-file params.yml \
            -profile <profile_name>,<...> \
            <...>

    The available profiles are ku_cpromegate, ku_sund_danhead_mod and dcai_gefion
        
        e.g.  -profile ku_cpromegate,cpr_ag
        e.g.  -profile ku_sund_danhead_mod
        e.g.  -profile dcai_gefion

    See README.md for the full profile list and per-profile docs.
========================================================================================
*/

profiles {
    dcai_gefion         { includeConfig "${params.custom_config_base}/conf/dcai_gefion.config"         }
    ku_cpromegate       { includeConfig "${params.custom_config_base}/conf/ku_cpromegate.config"       }
    ku_sund_danhead_mod { includeConfig "${params.custom_config_base}/conf/ku_sund_danhead_mod.config" }
}
